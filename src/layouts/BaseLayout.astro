---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { SITE } from '../consts';

interface Props {
  /** Page-specific title — site name is appended automatically. */
  title: string;
  /** Meta description (150–160 chars ideal). */
  description: string;
  /** Canonical path, e.g. '/about'. Defaults to current pathname. */
  canonical?: string;
  /** Open Graph image absolute URL. */
  ogImage?: string;
  /** Optional JSON-LD object(s) — passed through as a script tag. */
  schema?: object | object[];
  /** Disable indexing (e.g. for thin pages or 404). */
  noindex?: boolean;
  /** 'article' for guides (adds article:published/modified_time). */
  ogType?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = `${SITE.url}/og-default.png`,
  schema,
  noindex = false,
  ogType = 'website',
  datePublished,
  dateModified,
} = Astro.props;

const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
// Canonicals always use the trailing-slash form GitHub Pages serves (no-slash URLs 301 to it).
const rawCanonical = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const canonicalUrl = /\/$|\.[a-z0-9]+$/i.test(rawCanonical) ? rawCanonical : rawCanonical + '/';
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
  <meta name="theme-color" content="#0E1A3A" />
  <meta name="format-detection" content="telephone=yes" />

  <!-- Bing Webmaster Tools site verification -->
  <meta name="msvalidate.01" content="0E5D9741E7AB69619EBD8ADE6BE7B284" />

  <!-- Open Graph -->
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={ogType} />
  {ogType === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
  {ogType === 'article' && dateModified && <meta property="article:modified_time" content={dateModified} />}
  <meta property="og:locale" content="en_GB" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="kianlocks — Avocet ABS 3-star lock change, £149 flat, North &amp; Central London and Hertfordshire" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Icons / manifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <!-- Plain-text summary for AI assistants (llmstxt.org) -->
  <link rel="alternate" type="text/plain" href="/llms.txt" title="kianlocks facts for AI assistants" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <!-- Fonts: Inter (sans) + Fraunces (display serif). Self-hostable later for perf. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
  />

  <!-- JSON-LD structured data -->
  {schemaArray.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <a href="#main" class="sr-only">Skip to main content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyCta />
</body>
</html>
