---
import { SITE } from '../consts';
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Book a fitting in two minutes.',
  body = `${SITE.price} flat — cylinder, fitting and three keys. Email us your postcode and door type; we come back within two hours with the slot. No callout fees, no upsells, no negotiation.`,
} = Astro.props;
---
<section class="cta-strip">
  <div class="container cta-strip__inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-strip__buttons">
      <a href={SITE.emailHref} class="btn btn-primary">Book a fitting</a>
      <a href={SITE.phoneHref} class="btn btn-outline-light">Or call {SITE.phone}</a>
    </div>
  </div>
</section>
