---
import { SITE } from '../consts';
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Get a quote in two minutes.',
  body = `Email us with your postcode and door type and we'll come back within two hours with the slot and the ${SITE.price} fixed price. No callout fees, no upsells.`,
} = Astro.props;
---
<section class="cta-strip">
  <div class="container cta-strip__inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-strip__buttons">
      <a href={SITE.emailHref} class="btn btn-primary">Email {SITE.email}</a>
      <a href={SITE.phoneHref} class="btn btn-outline-light">Or call {SITE.phone}</a>
    </div>
  </div>
</section>
