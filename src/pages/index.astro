---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { SITE } from '../consts';
import { NORTH_LONDON, CENTRAL_LONDON } from '../data/boroughs';
import { FAQS } from '../data/faqs';
import {
  localBusinessSchema,
  websiteSchema,
  faqSchema,
  breadcrumbSchema,
} from '../lib/schema';

const schema = [
  websiteSchema(),
  localBusinessSchema(),
  faqSchema(FAQS),
  breadcrumbSchema([{ name: 'Home', url: SITE.url }]),
];
---
<BaseLayout
  title={SITE.name}
  description={SITE.description}
  schema={schema}
>
  <!-- ============= HERO ============= -->
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <span class="eyebrow" style="color: var(--gold)">North &amp; Central London · ABS Only</span>
        <h1>One lock change. <span class="gold">{SITE.price} flat.</span></h1>
        <p class="lead">
          We fit one product — Avocet ABS, the British Standard 3-star
          anti-snap cylinder. {SITE.price} all-in: cylinder, fitting,
          three keys, written invoice. No callout fees. No upsell ladder.
        </p>

        <div class="hero__ctas">
          <a href={SITE.emailHref} class="btn btn-primary">Email for a quote</a>
          <a href="/why-abs" class="btn btn-outline-light">Why ABS only?</a>
        </div>

        <div class="hero__trust">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> {SITE.price} flat fee — no surprises</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> TS007 3-star Kitemarked</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Reply within 2 hrs</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Fully insured</span>
        </div>
      </div>

      <aside class="hero__visual" aria-label="Avocet ABS specification">
        <div class="spec-card">
          <p class="spec-card__sub">Avocet ABS · TS007</p>
          <h3 class="spec-card__title">3-star anti-everything cylinder</h3>
          <ul class="spec-card__list">
            <li><span class="star">★</span><span><strong>Anti-snap</strong> — sacrificial sections defeat the &lsquo;London snap&rsquo; method</span></li>
            <li><span class="star">★</span><span><strong>Anti-bump</strong> — pin design eliminates bump-key attacks</span></li>
            <li><span class="star">★</span><span><strong>Anti-pick</strong> — patented sidebar resists manipulation</span></li>
            <li><span class="star">★</span><span><strong>Anti-drill</strong> — hardened steel inserts in critical locations</span></li>
          </ul>
          <div class="spec-card__rating">
            <strong>3★</strong>
            <span>British Standard TS007 Kitemarked</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============= WHO WE WORK WITH ============= -->
  <section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who we work with</span>
        <h2>Three jobs. One product. {SITE.price} flat.</h2>
        <p>
          We do one thing — change locks to Avocet ABS — for one of three
          reasons. If your job isn&rsquo;t one of these three, we&rsquo;re probably
          not the right locksmith for you, and we&rsquo;ll say so.
        </p>
      </div>

      <div class="grid-3">
        <div class="card">
          <div class="card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Landlords</h3>
          <p>
            Tenancy change. Old keys made worthless. Insurance-grade
            cylinder fitted before the new tenant moves in. Itemised
            invoice for your records. {SITE.price} per door.
          </p>
        </div>
        <div class="card">
          <div class="card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>Tenants</h3>
          <p>
            Just moved in and want your own keys, no one else&rsquo;s? We&rsquo;ll
            change the cylinder same week. Coordinate with your landlord
            or proceed independently — your choice.
          </p>
        </div>
        <div class="card">
          <div class="card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>Homeowners</h3>
          <p>
            Upgrading from a generic cylinder to a 3-star ABS — usually
            because the door looks vulnerable, the insurer asked, or
            you&rsquo;ve been reading about lock-snap attacks. {SITE.price}, done.
          </p>
        </div>
      </div>

      <div class="text-center mt-4">
        <a href="/why-abs" class="btn-ghost">Read the full ABS rationale</a>
      </div>
    </div>
  </section>

  <!-- ============= PROCESS ============= -->
  <section class="bg-cream">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Process</span>
        <h2>Email today. Fitted this week.</h2>
        <p>
          One email, one visit, one cylinder. No callout fees, no
          per-minute charges, no upsell talk on the doorstep.
        </p>
      </div>

      <div class="steps">
        <div class="step">
          <span class="step__phase">Phase one</span>
          <h3>Email us</h3>
          <p>
            Postcode, door type, the reason (new tenant, just moved
            in, security upgrade). We reply within 2 hours with a slot.
          </p>
        </div>
        <div class="step">
          <span class="step__phase">Phase two</span>
          <h3>We confirm</h3>
          <p>
            {SITE.price} flat — cylinder, fitting, three keys included.
            No hidden extras. Booked for a slot that suits you.
          </p>
        </div>
        <div class="step">
          <span class="step__phase">Phase three</span>
          <h3>Measure &amp; fit</h3>
          <p>
            We attend, measure the existing cylinder, and fit the
            ABS sized to sit flush. Typical visit: 30–45 minutes.
          </p>
        </div>
        <div class="step">
          <span class="step__phase">Phase four</span>
          <h3>Hand over</h3>
          <p>
            Three keys cut and tested with you. Itemised invoice
            naming the cylinder and rating — for your insurer or
            landlord file.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============= AREAS ============= -->
  <section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Coverage</span>
        <h2>Where we work</h2>
        <p>
          North &amp; Central London only. Pick your borough below for
          local detail and to confirm we cover your postcode.
        </p>
      </div>

      <div class="coverage">
        <div class="coverage__column">
          <h3>North London</h3>
          <div class="grid-2" style="gap:0.85rem;">
            {NORTH_LONDON.map((b) => (
              <a href={`/locksmith/${b.slug}`} class="card borough-card" style="padding:1.1rem 1.25rem;">
                <h3 style="font-size:1.2rem;margin:0;">{b.name}</h3>
                <p class="postcodes" style="margin-top:0.4rem;">{b.postcodes.slice(0,4).join(' · ')}</p>
              </a>
            ))}
          </div>
        </div>
        <div class="coverage__column">
          <h3>Central London</h3>
          <div class="grid-2" style="gap:0.85rem;">
            {CENTRAL_LONDON.map((b) => (
              <a href={`/locksmith/${b.slug}`} class="card borough-card" style="padding:1.1rem 1.25rem;">
                <h3 style="font-size:1.2rem;margin:0;">{b.name}</h3>
                <p class="postcodes" style="margin-top:0.4rem;">{b.postcodes.slice(0,4).join(' · ')}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============= FAQ ============= -->
  <section class="bg-cream">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>The things people ask</h2>
        <p>If your question isn&rsquo;t here, email us — we&rsquo;ll talk you through it.</p>
      </div>

      <div class="faq-list">
        {FAQS.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <div class="faq__body">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip />
</BaseLayout>
