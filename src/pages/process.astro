---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { SITE } from '../consts';
import { breadcrumbSchema, localBusinessSchema } from '../lib/schema';

const schema = [
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: 'Process', url: `${SITE.url}/process` },
  ]),
];
---
<BaseLayout
  title="How a kianlocks lock change works"
  description={`Email today, fitted this week. ${SITE.price} flat fee — cylinder, fitting, three keys included. The exact process from quote to handover.`}
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Process' }]} />
      <h1>Email today. Fitted this week. {SITE.price} flat.</h1>
      <p class="lead">
        We&rsquo;ve stripped the lock change to four predictable steps
        — quoted in writing, booked by email, fitted in 30–45
        minutes, no upsell on the doorstep.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="steps">
        <div class="step">
          <span class="step__phase">Phase one</span>
          <h3>Email us</h3>
          <p>
            Tell us your postcode, the door material (uPVC, composite,
            timber), and the reason for the change (tenancy change,
            new tenant, security upgrade). Use the form on the
            contact page or email <a href={SITE.emailHref} style="color:inherit;text-decoration:underline;">{SITE.email}</a>.
          </p>
        </div>
        <div class="step">
          <span class="step__phase">Phase two</span>
          <h3>We confirm in writing</h3>
          <p>
            Reply within 2 hours during office hours. {SITE.price}
            flat — cylinder, fitting, three keys, written invoice.
            We propose a slot; you confirm.
          </p>
        </div>
        <div class="step">
          <span class="step__phase">Phase three</span>
          <h3>Measure &amp; fit</h3>
          <p>
            We attend at the agreed time, measure the existing
            cylinder, and fit an Avocet ABS sized to sit flush against
            the handle escutcheon. Typical visit: 30–45 minutes.
          </p>
        </div>
        <div class="step">
          <span class="step__phase">Phase four</span>
          <h3>Test, hand over, document</h3>
          <p>
            Three keys cut and tested with you. Itemised invoice
            naming the product, rating, and serial number — keep it
            for your insurer, landlord file, or freeholder.
          </p>
        </div>
      </div>

      <article class="prose mt-4" style="margin-top:3rem;">
        <h2>Need us out of hours? 24/7 emergency callout</h2>
        <p>
          The four-step process above describes our standard
          planned booking — the £149 flat-fee path. We also run a
          24/7 emergency callout for situations that can&rsquo;t wait:
          you&rsquo;re locked out, your door has taken an attempted
          snap attack, or there&rsquo;s a tenancy access issue overnight.
        </p>
        <p>
          Emergency work is <strong>quoted per job</strong> rather than
          fixed at £149, because the price depends on the time of day,
          your location, and what we find on arrival. Email
          <a href={SITE.emailHref}>{SITE.email}</a> with EMERGENCY in
          the subject line, or call <a href={SITE.phoneHref}>{SITE.phone}</a>
          and we&rsquo;ll quote on the call.
        </p>

        <h2>What you do not need to do</h2>
        <ul>
          <li><strong>Stay in.</strong> We can collect a key from a neighbour, agent, or building concierge if you arrange it in advance.</li>
          <li><strong>Replace the door.</strong> ABS sizes exist for almost every standard door — the cylinder is the only thing that changes.</li>
          <li><strong>Buy parts in advance.</strong> Everything is on the van — cylinders, the right tools, fixings, three keys cut to match.</li>
          <li><strong>Call to chase.</strong> We reply by email within 2 hours, with the slot, the price and what to expect.</li>
          <li><strong>Pay before you see the work.</strong> Payment after the job is signed off — card or bank transfer.</li>
        </ul>

        <h2>What we won&rsquo;t do</h2>
        <ul>
          <li>Try to upsell you a smart lock you didn&rsquo;t ask for.</li>
          <li>Quote a callout fee then add hourly labour on top.</li>
          <li>Fit a 1-star cylinder &lsquo;to save money&rsquo; — that&rsquo;s the entire problem we exist to solve.</li>
          <li>Mix the £149 flat fee with emergency or out-of-hours work — those are quoted separately so the standard price stays standard.</li>
          <li>Leave the door without testing the cylinder cycles smoothly with all three keys.</li>
        </ul>
      </article>
    </div>
  </section>

  <CtaStrip />
</BaseLayout>
