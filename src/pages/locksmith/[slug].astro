---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaStrip from '../../components/CtaStrip.astro';
import { SITE } from '../../consts';
import { BOROUGHS } from '../../data/boroughs';
import { FAQS } from '../../data/faqs';
import {
  localBusinessSchema,
  boroughServiceSchema,
  faqSchema,
  breadcrumbSchema,
} from '../../lib/schema';

export function getStaticPaths() {
  return BOROUGHS.map((b) => ({ params: { slug: b.slug }, props: { borough: b } }));
}

const { borough } = Astro.props;
const url = `${SITE.url}/locksmith/${borough.slug}`;

const schema = [
  localBusinessSchema(),
  boroughServiceSchema(borough),
  faqSchema(FAQS.slice(0, 5)),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: 'Areas', url: `${SITE.url}/areas` },
    { name: borough.name, url },
  ]),
];
---
<BaseLayout
  title={`Locksmith in ${borough.name} — ABS only`}
  description={borough.metaDescription}
  schema={schema}
  canonical={url}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[
        { name: 'Home', href: '/' },
        { name: 'Areas', href: '/areas' },
        { name: borough.name },
      ]} />
      <h1>{borough.h1}</h1>
      <p class="lead">{borough.lead}</p>

      <dl class="borough-meta">
        <div>
          <dt>Postcodes covered</dt>
          <dd>{borough.postcodes.join(' · ')}</dd>
        </div>
        <div>
          <dt>Flat fee</dt>
          <dd>{SITE.price} all-in</dd>
        </div>
        <div>
          <dt>Booking</dt>
          <dd>2–5 working days</dd>
        </div>
      </dl>
    </div>
  </section>

  <section>
    <div class="container">
      <article class="prose">
        <h2>What we do in {borough.name}</h2>
        <p>{borough.bodyParagraphs[0]}</p>
        <p>{borough.bodyParagraphs[1]}</p>

        <h2>A common {borough.name} job</h2>
        <p>{borough.commonIssue}</p>

        <h2>Areas covered within {borough.name}</h2>
        <div class="pills">
          {borough.landmarks.map((l) => <span class="pill">{l}</span>)}
        </div>

        <h2>Why ABS — even more relevant in {borough.name}</h2>
        <p>
          The London snap-attack method does not discriminate by
          borough — but the housing stock does affect which doors are
          most exposed. Whether you have a Victorian timber front door,
          a uPVC back door, or a composite door on a new-build flat, the
          euro cylinder is what holds it shut. We replace it with the
          only cylinder rated 3-star against snap, bump, pick and drill
          attack independently:
          <a href="/why-abs"> Avocet ABS</a>.
        </p>

        <h2>What it costs</h2>
        <p>
          <strong>{SITE.price} flat.</strong> Cylinder, fitting, three
          keys, written invoice — all included. No callout fee, no
          per-minute labour, no upsell on the doorstep. The price you
          read is the price you pay.
        </p>

        <h2>Who we work with in {borough.name}</h2>
        <p>
          Three jobs make up almost all our {borough.name} work:
          <strong>landlords</strong> doing tenancy-change lock changes,
          <strong>tenants</strong> wanting their own keys after moving
          in, and <strong>homeowners</strong> upgrading from a generic
          cylinder to a 3-star ABS. If your job is one of those three,
          email us with your postcode and door type — we&rsquo;ll come
          back within 2 hours with a slot.
        </p>

        <h2>How to book</h2>
        <p>
          Email <a href={SITE.emailHref}>{SITE.email}</a> with:
        </p>
        <ul>
          <li>Your postcode</li>
          <li>Door material (uPVC, composite, hardwood)</li>
          <li>The reason for the change (new tenant, just moved in, security upgrade)</li>
          <li>Preferred day or time window</li>
        </ul>
        <p>
          We typically book within 2–5 working days. Reply within 2
          hours during office hours. Note: we are not an emergency or
          24-hour service.
        </p>
      </article>

      <div class="text-center mt-5">
        <a href={SITE.emailHref} class="btn btn-primary">Book a {borough.name} fitting</a>
      </div>
    </div>
  </section>

  <CtaStrip
    heading={`${borough.name} ABS lock change — ${SITE.price} flat.`}
    body={`Avocet ABS fitting across ${borough.postcodes.slice(0, 3).join(', ')} and the wider ${borough.name} area. Email with your postcode and door type — we reply within 2 hours.`}
  />
</BaseLayout>
