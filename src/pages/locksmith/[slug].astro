---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaStrip from '../../components/CtaStrip.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { SITE } from '../../consts';
import { BOROUGHS, boroughBySlug } from '../../data/boroughs';
import { BOROUGH_LOCAL } from '../../data/boroughLocal';
import type { FAQ } from '../../data/faqs';
import {
  localBusinessSchema,
  boroughServiceSchema,
  breadcrumbSchema,
} from '../../lib/schema';

export function getStaticPaths() {
  return BOROUGHS.map((b) => ({ params: { slug: b.slug }, props: { borough: b } }));
}

const { borough } = Astro.props;
const url = `${SITE.url}/locksmith/${borough.slug}/`;
const inName = borough.slug === 'city-of-london' ? 'the City of London' : borough.name;
const nearby = borough.nearby.map(boroughBySlug).filter(Boolean);
const local = BOROUGH_LOCAL[borough.slug];

const faqs: FAQ[] = [
  ...(local ? [local.faq] : []),
  {
    q: `How much does a lock change cost in ${inName}?`,
    a: `${SITE.price} flat for a planned booking (Mon–Sat 9am–6pm): an Avocet ABS 3-star cylinder sized to your door, fitting, three keys and an itemised invoice. No callout fee and no hourly labour. Out-of-hours emergencies in ${inName} are quoted per job before we set off.`,
  },
  {
    q: `Which ${inName} postcodes do you cover?`,
    a: `We cover ${borough.postcodes.join(', ')} — including ${borough.landmarks.slice(0, 4).join(', ')}. If you are just outside, email your postcode and we will confirm.`,
  },
  {
    q: `How soon can you change my lock in ${inName}?`,
    a: `Planned bookings are usually within 2–5 working days of your email and we reply within 2 hours during office hours. If you are locked out or the door is insecure after a break-in, call ${SITE.phone} for the 24/7 emergency service, which is quoted per job.`,
  },
];

const schema = [
  localBusinessSchema(),
  boroughServiceSchema(borough),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: 'Areas', url: `${SITE.url}/areas/` },
    { name: borough.name, url },
  ]),
];
---
<BaseLayout
  title={borough.title}
  description={borough.metaDescription}
  schema={schema}
  canonical={url}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[
        { name: 'Home', href: '/' },
        { name: 'Areas', href: '/areas/' },
        { name: borough.name },
      ]} />
      <h1>{borough.h1}</h1>
      <p class="lead">{borough.lead}</p>

      <dl class="borough-meta">
        <div>
          <dt>Postcodes covered</dt>
          <dd>{borough.postcodes.join(' · ')}</dd>
        </div>
        <div>
          <dt>Planned lock change</dt>
          <dd>{SITE.price} all-in</dd>
        </div>
        <div>
          <dt>Booking</dt>
          <dd>2–5 working days · emergencies 24/7 by quote</dd>
        </div>
      </dl>
    </div>
  </section>

  <section>
    <div class="container">
      <article class="prose">
        <QuickAnswer>
          <p>
            A planned lock change in {inName} costs <strong>{SITE.price} flat</strong> with Kianlocks: an Avocet ABS
            3-star cylinder, fitting and three keys. Email <a href={SITE.emailHref}>{SITE.email}</a> with your postcode to book.
          </p>
        </QuickAnswer>

        <h2>What we do in {borough.name}</h2>
        <p>{borough.bodyParagraphs[0]}</p>
        <p>{borough.bodyParagraphs[1]}</p>

        <h2>A common {borough.name} job</h2>
        <p>{borough.commonIssue}</p>

        <h2>Areas covered within {borough.name}</h2>
        <div class="pills">
          {borough.landmarks.map((l) => <span class="pill">{l}</span>)}
        </div>

        {local && (
          <>
            <h2>{local.guideHeading}</h2>
            <p>{local.guide[0]}</p>
            <p>{local.guide[1]}</p>
          </>
        )}

        <h2>Why ABS and what it costs</h2>
        <p>
          The euro cylinder is what holds most doors shut, so we replace it with an
          <a href="/why-abs/">Avocet ABS</a> rated <a href="/guides/ts007-3-star-explained/">TS007 3-star</a> on its own.
          <strong>{SITE.price} flat</strong> covers the cylinder, fitting, three keys and an invoice.
          See the <a href="/guides/lock-change-cost-london/">lock change cost guide</a> for how that compares.
        </p>

        <p>
          We work for <a href="/landlord-lock-change-london/">landlords</a>, <a href="/new-tenant-lock-change-london/">tenants</a>
          and <a href="/3-star-lock-upgrade-london/">homeowners</a> across {borough.name}.
        </p>

        <h2>How to book in {borough.name}</h2>
        <p>
          Email <a href={SITE.emailHref}>{SITE.email}</a> with your postcode, door type, the reason for the change
          and a preferred time. We reply within 2 hours in office hours and usually book within 2–5 working days.
          {local && <> {local.bookingNote}</>}
          Locked out or insecure after a break-in? Call <a href={SITE.phoneHref}>{SITE.phone}</a> for our
          <a href="/emergency-locksmith-london/">24/7 emergency service</a>.
        </p>

        <FaqBlock faqs={faqs} heading={`${borough.name} lock change questions`} bare />

        <RelatedLinks
          heading={`Also covering near ${borough.name}`}
          links={nearby.map((n) => ({ href: `/locksmith/${n!.slug}/`, title: `Locksmith ${n!.name}`, blurb: n!.postcodes.slice(0, 4).join(' · ') }))}
        />
      </article>

      <div class="text-center mt-5">
        <a href={SITE.emailHref} class="btn btn-primary">Book a {borough.name} fitting</a>
      </div>
    </div>
  </section>

  <CtaStrip
    heading={`${borough.name} ABS lock change — ${SITE.price} flat.`}
    body={`Avocet ABS fitting across ${borough.postcodes.slice(0, 3).join(', ')} and the wider ${borough.name} area. Email with your postcode and door type — we reply within 2 hours.`}
  />
</BaseLayout>
