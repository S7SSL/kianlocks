---
import ContentLayout from '../layouts/ContentLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FaqBlock from '../components/FaqBlock.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { SITE } from '../consts';

const path = '/emergency-locksmith-london';
const faqs = [
  {
    q: 'How much is an emergency locksmith in London?',
    a: `Ours is quoted per job, before we travel, because it depends on the time, your location and what has happened. Published cost guides put out-of-hours callout fees at about £50–£150 and whole emergency jobs at about £150–£250. Our planned (non-emergency) lock change is ${SITE.price} flat.`,
  },
  {
    q: 'What counts as an emergency?',
    a: 'Being locked out, a snapped or damaged cylinder, a door you cannot secure after a break-in or attempted break-in, or an urgent tenancy access problem. If it can wait for a normal weekday slot, the planned £149 booking is cheaper.',
  },
  {
    q: 'How do I reach you in an emergency?',
    a: `Call ${SITE.phone}. If you email, put EMERGENCY in the subject line and include your postcode and what has happened.`,
  },
  {
    q: 'Will you replace the lock?',
    a: 'If the cylinder needs replacing, we fit an Avocet ABS 3-star, the same product we fit on planned jobs. We tell you the price before we start.',
  },
];
---
<ContentLayout
  path={path}
  lead="Locked out, snapped cylinder, or a door you can’t secure after a break-in? We run a 24/7 emergency callout across North & Central London and Hertfordshire — quoted per job, before anyone sets off."
  audience="Anyone locked out or with an insecure door"
  ctaHeading="Emergency? Call first."
  ctaBody={`Call ${SITE.phone} any time. Tell us your postcode and what has happened — we give you a price before we travel.`}
>
  <QuickAnswer>
    <p>
      kianlocks runs a <strong>24/7 emergency locksmith callout</strong> across North &amp; Central London and Hertfordshire for lockouts,
      snapped or damaged cylinders and doors left insecure after a break-in. Emergency work is <strong>quoted per job
      before we travel</strong>. Call <a href={SITE.phoneHref}>{SITE.phone}</a>. Non-urgent lock changes are {SITE.price} flat.
    </p>
  </QuickAnswer>

  <h2>What we handle 24/7</h2>
  <ul>
    <li>Locked out of your home.</li>
    <li>A snapped, damaged or jammed euro cylinder.</li>
    <li>A door you can’t lock after a break-in or attempted break-in.</li>
    <li>Urgent access problems at the start or end of a tenancy.</li>
  </ul>
  <p>We don’t do car keys, safes or smart locks.</p>

  <h2>How pricing works</h2>
  <p>
    Out-of-hours prices vary with the time of day, travel and what we find, so we don’t publish a single
    emergency price. We quote on the phone before anyone sets off, and you decide. For context, published
    guides put out-of-hours callout fees at about £50–£150 — see our <a href="/guides/lock-change-cost-london/">lock change cost guide</a>.
  </p>

  <h2>After a break-in</h2>
  <ol>
    <li>If anyone may still be inside or you are in danger, call 999.</li>
    <li>Report the burglary to the police and note the crime reference number for your insurer.</li>
    <li>Call us to make the door secure. Ask for an itemised invoice for your insurance claim.</li>
  </ol>

  <h2>Areas</h2>
  <p>
    <a href="/locksmith/camden/">Camden</a>, <a href="/locksmith/islington/">Islington</a>,
    <a href="/locksmith/haringey/">Haringey</a>, <a href="/locksmith/barnet/">Barnet</a>,
    <a href="/locksmith/enfield/">Enfield</a>, <a href="/locksmith/hackney/">Hackney</a>,
    <a href="/locksmith/westminster/">Westminster</a>, the <a href="/locksmith/city-of-london/">City of London</a> and
    <a href="/locksmith/kensington-and-chelsea/">Kensington &amp; Chelsea</a>, and in Hertfordshire <a href="/locksmith/hertsmere/">Potters Bar &amp; Borehamwood</a>,
    <a href="/locksmith/broxbourne/">Cheshunt &amp; Broxbourne</a>, <a href="/locksmith/welwyn-hatfield/">Hatfield &amp; Welwyn Garden City</a>
    and <a href="/locksmith/st-albans/">St Albans &amp; Harpenden</a>.
  </p>

  <FaqBlock faqs={faqs} heading="Emergency questions" bare />

  <RelatedLinks links={[
    { href: '/guides/lock-snapping-explained/', title: 'Lock snapping explained', blurb: 'Stop it happening again.' },
    { href: '/3-star-lock-upgrade-london/', title: 'Upgrade to 3-star', blurb: `${SITE.price} planned.` },
    { href: '/contact/', title: 'Book a planned fitting', blurb: `${SITE.price} flat.` },
  ]} />
</ContentLayout>
