---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../consts';
import { breadcrumbSchema, localBusinessSchema } from '../lib/schema';

const schema = [
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: 'Contact', url: `${SITE.url}/contact` },
  ]),
];

/**
 * The form below uses Formsubmit.co — a free, no-account form-to-email service
 * that works on static sites. The form posts to formsubmit.co/<your-email>,
 * which sends each submission to hi@kianlocks.com. First submission shows
 * a captcha that must be confirmed once — after that it works without account.
 *
 * Alternative: swap to Formspree (free 50/mo at formspree.io) by changing
 * the action URL to https://formspree.io/f/YOUR_FORM_ID.
 */
const formAction = `https://formsubmit.co/${SITE.email}`;
---
<BaseLayout
  title="Contact kianlocks"
  description={`Email kianlocks for an Avocet ABS lock change quote. ${SITE.price} flat fee — cylinder, fitting, three keys included. North & Central London.`}
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />
      <h1>Book a fitting. {SITE.price} flat.</h1>
      <p class="lead">
        Send us the postcode, the door type and why you&rsquo;re
        changing the lock. We reply within 2 hours with a slot.
        One service, one price — no quote needed.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="contact-grid">
        <!-- ============= FORM ============= -->
        <div>
          <form
            class="quote-form"
            action={formAction}
            method="POST"
            aria-label="Request a lock change quote"
          >
            <!-- formsubmit.co configuration (these inputs are not displayed) -->
            <input type="hidden" name="_subject" value="ABS lock change booking — kianlocks.com" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value={`${SITE.url}/contact?sent=1`} />
            <!-- honeypot for bots -->
            <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

            <div class="field">
              <label for="name">Your name <span class="req">*</span></label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="email">Email <span class="req">*</span></label>
                <input id="email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="field">
                <label for="phone">Phone (optional)</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" />
              </div>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="postcode">Postcode <span class="req">*</span></label>
                <input id="postcode" name="postcode" type="text" required placeholder="e.g. NW1 7AA" autocomplete="postal-code" />
              </div>
              <div class="field">
                <label for="door">Door material <span class="req">*</span></label>
                <select id="door" name="door" required>
                  <option value="">Choose…</option>
                  <option>uPVC</option>
                  <option>Composite</option>
                  <option>Hardwood / timber</option>
                  <option>Other / not sure</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="reason">Why are you changing the lock? <span class="req">*</span></label>
              <select id="reason" name="reason" required>
                <option value="">Choose…</option>
                <option>Landlord — tenancy change (£149 flat)</option>
                <option>Tenant — just moved in (£149 flat)</option>
                <option>Homeowner — security upgrade (£149 flat)</option>
                <option>EMERGENCY / 24-hour callout (quoted per job)</option>
                <option>Other</option>
              </select>
            </div>

            <div class="field">
              <label for="notes">Anything else we should know? (optional)</label>
              <textarea id="notes" name="notes" rows="3" placeholder="Preferred days/times, building access notes, photos can be attached after first reply…"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Send booking request</button>
            <p class="form-note">
              We reply within 2 hours during office hours
              (Mon–Sat 9am–6pm) with a fitting slot. {SITE.price}
              flat, confirmed by email. No call-back unless you
              ask for one.
            </p>
          </form>
        </div>

        <!-- ============= ALT CONTACT METHODS ============= -->
        <aside class="contact-side">
          <div class="card">
            <h3 style="font-size:1.25rem; margin-bottom:0.85rem;">Prefer to email direct?</h3>
            <p class="muted">
              Skip the form. Send us a note with your postcode and door type:
            </p>
            <p class="mt-2">
              <a href={SITE.emailHref} class="btn btn-outline" style="font-size:0.85rem;">
                {SITE.email}
              </a>
            </p>
          </div>

          <div class="card mt-3">
            <h3 style="font-size:1.25rem; margin-bottom:0.85rem;">Phone</h3>
            <p class="muted">
              We answer phones {SITE.hours.toLowerCase()}, but email
              is faster — most bookings are confirmed within 2 hours.
            </p>
            <p class="mt-2">
              <a href={SITE.phoneHref} class="btn btn-outline" style="font-size:0.85rem;">
                {SITE.phone}
              </a>
            </p>
          </div>

          <div class="card mt-3" style="background: var(--surface);">
            <h3 style="font-size:1.15rem; margin-bottom:0.85rem;">Two service paths</h3>
            <p style="font-size:0.9rem; color:var(--on-surface-variant); margin-bottom:0.85rem;">
              <strong>Planned booking — £149 flat.</strong>
              Mon–Sat 9am–6pm. Email this form with your postcode and
              door type. We confirm a slot and price within 2 hours.
            </p>
            <p style="font-size:0.9rem; color:var(--on-surface-variant); margin:0;">
              <strong>24/7 emergency — quoted per job.</strong>
              For genuine emergencies (locked out, attempted snap, urgent
              tenancy access). Use the form with EMERGENCY selected, or
              call <a href={SITE.phoneHref} style="color:inherit;text-decoration:underline;">{SITE.phone}</a>.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.85fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 920px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  .quote-form { display: grid; gap: 1.25rem; }
  .quote-form .field { display: grid; gap: 0.4rem; }
  .quote-form .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 600px) { .quote-form .field-row { grid-template-columns: 1fr; } }
  .quote-form label {
    font-family: var(--font-sans);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .quote-form .req { color: var(--gold); }
  .quote-form input,
  .quote-form select,
  .quote-form textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: inherit;
    font-size: var(--t-body);
    color: var(--on-surface);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color 180ms ease;
  }
  .quote-form input:focus,
  .quote-form select:focus,
  .quote-form textarea:focus {
    outline: none;
    border-color: var(--navy);
    border-width: 1.5px;
  }
  .quote-form textarea { resize: vertical; min-height: 90px; }
  .quote-form button[type="submit"] {
    justify-self: start;
    margin-top: 0.5rem;
    padding: 1.1rem 2.25rem;
  }
  .form-note {
    font-size: var(--t-caption);
    color: var(--on-surface-variant);
    line-height: 1.5;
    margin-top: 0.5rem;
  }
  .contact-side { display: grid; gap: 1rem; }
</style>

<!-- Show success message on return after form submit -->
<script>
  if (new URLSearchParams(location.search).has('sent')) {
    const main = document.getElementById('main');
    if (main) {
      const banner = document.createElement('div');
      banner.className = 'sent-banner';
      banner.setAttribute('role', 'status');
      banner.innerHTML = '<strong>Got it.</strong> We&rsquo;ll be in touch within 2 hours during office hours. Check your email (and spam folder).';
      main.prepend(banner);
    }
  }
</script>

<style is:global>
  .sent-banner {
    background: #d4edda;
    color: #0f5132;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #b5dfc1;
    text-align: center;
    font-size: var(--t-body);
  }
</style>
